{
    "name": "Gleam Dev",  
    "build": {
      "dockerfile": "Dockerfile",
      "args": {
        "ERLANG_TAG": "27.2.1-alpine",
        "GLEAM_RELEASE_TAG": "v1.8.0"
      }
    },
    "customizations": {
          "vscode": {
            "extensions": [
              "Gleam.Gleam"
            ]
          }
     },
     "features": {
          "ghcr.io/devcontainers/features/common-utils:2": {
              "installZsh": "true",
              "username": "vscode",
              "userUid": "1000",
              "userGid": "1000",
              "upgradePackages": "false"
          }
    },
    "remoteUser": "vscode"
  }